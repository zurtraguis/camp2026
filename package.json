{
  "name": "vibecoding-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:journey": "vitest run --config vitest.journey.config.ts",
    "verify:docs-product": "bash scripts/verify-docs.sh",
    "verify:docs-integrity": "bash scripts/verify-docs-integrity.sh",
    "verify:framework": "bash scripts/verify-framework.sh",
    "verify:commands": "node scripts/verify-command-skills.mjs",
    "verify:harness-init": "bash scripts/verify-harness-init.sh",
    "verify:skills": "node scripts/audit-skills.mjs",
    "harness:status": "node scripts/harness-status.mjs",
    "harness:config": "node scripts/harness-config.mjs",
    "harness:snapshot": "node scripts/snapshot.mjs",
    "harness:doctor": "node scripts/harness-doctor.mjs",
    "harness:phase": "node scripts/phase-state.mjs",
    "harness:install-hooks": "node scripts/install-hooks.mjs",
    "manifest": "node scripts/generate-framework-manifest.mjs",
    "check:metadata": "node scripts/check-metadata-contract.mjs",
    "sitemap": "npx tsx scripts/generate-sitemap.ts",
    "lhci": "npx --yes @lhci/cli autorun",
    "db:seed": "prisma db seed",
    "db:demo:wipe": "tsx prisma/wipe-demo.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "verify": "bash scripts/verify-docs.sh && bash scripts/verify-framework.sh && bash scripts/verify-docs-integrity.sh && node scripts/verify-command-skills.mjs",
    "verify:all": "npm run verify && npm run verify:skills && npm run verify:harness-init && npm run test:journey"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.1",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "stripe": "^22.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.0.2",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.3",
    "wrangler": "^4.104.0"
  },
  "engines": {
    "node": ">=20"
  }
}
