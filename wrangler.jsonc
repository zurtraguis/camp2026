{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acamp2026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Variáveis PÚBLICAS (NEXT_PUBLIC_*) — podem ficar versionadas.
  // Os SEGREDOS (DATABASE_URL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // SUPABASE_SERVICE_ROLE_KEY, AUTH_SECRET) vão via `wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://acamp2026.futagoautomacoes.com.br",
    "NEXT_PUBLIC_APP_NAME": "Acampamento RAIZ 2026",
    "NEXT_PUBLIC_SUPABASE_URL": "https://orhciovdecwaqqsxxdfb.supabase.co",
    "SUPABASE_COMPROVANTES_BUCKET": "comprovantes",
    "NEXT_PUBLIC_PIX_KEY": "paulotorresneto@gmail.com",
    "NEXT_PUBLIC_PIX_RECEIVER_NAME": "ACAMPAMENTO RAIZ",
    "NEXT_PUBLIC_PIX_RECEIVER_CITY": "Manaus",
    "NEXT_PUBLIC_CONSENT_TERM_VERSION": "v1-2026-06",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51Sdwf3LVGuIIljwHjq2WC8lA5Ukxmu8zRXH3XsWKL45PEyrSzgNZlv1bJZB1QLcmz0NFpr3UZVtuGsinz9Vmtl1C00qqVHdf2t"
  }
}
