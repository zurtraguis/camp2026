# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://acamp2026.futagoautomacoes.com.br"
NEXT_PUBLIC_APP_NAME="Acampamento RAIZ 2026"

# ─── Banco (Supabase Postgres) ───────────────────────────────────────────────
# DATABASE_URL: usado em runtime (pooler porta 6543 + ?pgbouncer=true).
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL: porta 5432, usado APENAS por `prisma migrate` (sem pooler).
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ─── Stripe (cartão) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── Storage de comprovantes Pix ─────────────────────────────────────────────
# Opção A (preferida): S3 compatível — SeaweedFS / MinIO / R2. Se preenchido,
# tem prioridade sobre o Supabase abaixo.
S3_ENDPOINT="https://s3.seu-servidor.com.br"  # endpoint do SeaweedFS S3 (sem bucket)
S3_REGION="us-east-1"                          # SeaweedFS aceita qualquer região
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="comprovantes"                       # criar bucket PRIVADO
S3_FORCE_PATH_STYLE="true"                     # SeaweedFS/MinIO usam path-style

# Opção B (fallback): Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."   # ou service_role (formato legado)
SUPABASE_COMPROVANTES_BUCKET="comprovantes" # criar bucket PRIVADO com este nome

# ─── Pix manual (chave + dados do recebedor para o "copia e cola") ───────────
NEXT_PUBLIC_PIX_KEY="chave-pix@exemplo.com"       # CPF/CNPJ/e-mail/telefone/aleatória
NEXT_PUBLIC_PIX_RECEIVER_NAME="ACAMPAMENTO RAIZ"  # máx 25 chars, sem acento
NEXT_PUBLIC_PIX_RECEIVER_CITY="Manaus"            # máx 15 chars, sem acento

# ─── Consentimento (LGPD) ────────────────────────────────────────────────────
NEXT_PUBLIC_CONSENT_TERM_VERSION="v1-2026-06"

# ─── Sessão admin ────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-com-no-minimo-16-chars"
