generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: URLs ficam em prisma.config.ts (DATABASE_URL runtime, DIRECT_URL migrations).
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (reaproveitado pela DAL existente) — usado pelo painel admin.
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF // futura: equipe de saúde/pastoral com acesso à triagem
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STAFF)
  passwordHash  String? // PBKDF2 (Web Crypto) — Workers-safe, sem dependência nativa
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Auditoria: pagamentos Pix revisados por este admin.
  reviewedPayments Payment[] @relation("PaymentReviewer")
  // Auditoria: parcelas de carnê revisadas por este admin.
  reviewedInstallments Installment[] @relation("InstallmentReviewer")

  // Auditoria dos custos do acampamento.
  createdExpenses  Expense[]        @relation("ExpenseCreator")
  recordedPayments ExpensePayment[] @relation("ExpensePaymentRecorder")

  @@index([isDemo])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotência de webhooks Stripe: o id é o event.id (evt_...).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Domínio — Acampamento RAIZ 2026
// ─────────────────────────────────────────────────────────────────────────────

// As 3 tribos reveladas no sábado (Gálatas 5.22-23).
// Pistis saiu em ago/2026 — ver migration `20260824_tribos_tres`.
enum Tribo {
  AGAPE // amor
  EIRENE // paz
  CHARA // alegria
}

enum Gender {
  MALE
  FEMALE
}

enum RegistrationStatus {
  PENDING_PAYMENT // inscrição criada, aguardando pagamento
  AWAITING_REVIEW // Pix com comprovante enviado, aguardando admin
  CONFIRMED // pago/confirmado
  INACTIVE // sumiu e não pagou: libera a vaga e sai da tribo, mas pode voltar
  CANCELLED
}

enum PaymentMethod {
  CARD // Stripe Checkout
  PIX // manual (chave + comprovante)
}

enum PaymentStatus {
  PENDING // criado, sem pagamento
  AWAITING_REVIEW // comprovante Pix enviado
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
}

// Lotes de inscrição: o preço vigente é o do lote ativo com vagas.
model Lote {
  id         String   @id @default(cuid())
  name       String // "1º Lote"
  order      Int      @unique // 1, 2, 3
  priceCents Int // 30000, 40000, 45000
  capacity   Int // nº de vagas neste lote
  active     Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  registrations Registration[]

  @@index([order])
}

model Registration {
  id        String @id @default(cuid())
  // Identificador curto e legível para o txid do Pix e para o campista.
  publicCode String @unique

  // Dados do campista
  fullName  String
  birthDate DateTime
  gender    Gender
  ageAtCamp Int // snapshot calculado na inscrição — usado no balanceamento
  cpf       String? // opcional
  phone     String?
  email     String?
  shirtSize String?
  church    String?
  city      String?

  // Tribo atribuída no momento da inscrição (balanceamento estratificado).
  // Nula quando a inscrição está DESATIVADA: quem não vem não ocupa lugar numa
  // tribo. Ao reativar, recebe tribo de novo como quem se inscreve naquele dia.
  tribo Tribo?

  status RegistrationStatus @default(PENDING_PAYMENT)
  isDemo Boolean            @default(false)

  // Observação livre da organização sobre esta inscrição (bolsa combinada,
  // pendência com a família, o que for). Interno: nunca sai para o campista.
  adminNotes String?

  // Coordenador que ora por este campista. onDelete: SetNull — remover um
  // coordenador não pode apagar a inscrição; o campista volta para a fila e
  // a próxima distribuição o pega.
  intercessorId String?
  intercessor   Coordinator? @relation(fields: [intercessorId], references: [id], onDelete: SetNull)

  loteId String
  lote   Lote   @relation(fields: [loteId], references: [id])

  guardian Guardian?
  health   HealthProfile?
  consent  ConsentRecord?
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tribo])
  @@index([status])
  @@index([gender, ageAtCamp])
  @@index([isDemo])
  @@index([intercessorId])
}

// Lixeira das inscrições excluídas.
//
// O botão Excluir apagava em cascata sem deixar rastro — e uma exclusão feita
// por engano era perda definitiva. Aqui fica a FOTOGRAFIA completa da inscrição
// (campista, responsável, saúde, consentimento, pagamento e parcelas) em JSON,
// o suficiente para reconstruí-la inteira.
//
// Não tem relação com Registration de propósito: a inscrição não existe mais.
model DeletedRegistration {
  id String @id @default(cuid())

  /// Id original — restaurar com ele mantém válido o caminho do comprovante
  /// no storage, que é nomeado pelo id da inscrição.
  registrationId String @unique
  publicCode     String
  fullName       String

  deletedAt    DateTime @default(now())
  deletedById  String?
  deletedByName String?
  /// Por que foi excluída. Daqui a um mês ninguém lembra.
  reason       String?

  /// Fotografia completa, para reconstruir a inscrição.
  snapshot Json

  /// Quando foi restaurada (null = ainda na lixeira).
  restoredAt DateTime?

  @@index([deletedAt])
}

// Coordenador de intercessão: quem ora por um grupo de campistas.
model Coordinator {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campers Registration[]
}

// Responsável legal — autorização do menor.
model Guardian {
  id             String @id @default(cuid())
  registrationId String @unique

  name         String
  cpf          String // documento do responsável
  phone        String
  email        String?
  relationship String // pai, mãe, responsável legal

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// Dados sensíveis (LGPD art. 11) — acesso restrito a ADMIN/STAFF.
// Mantido em tabela separada para nunca vazar em exports gerais.
model HealthProfile {
  id             String @id @default(cuid())
  registrationId String @unique

  allergies           String?
  medications         String?
  dietaryRestrictions String?
  chronicConditions   String?
  healthNotes         String?

  // Triagem confidencial (manual seção 10): cada flag gera um líder-âncora.
  triageFlags String[] // luto, ansiedade_depressao, situacao_familiar, neurodivergencia, primeira_vez
  triageNotes String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// Registro de consentimento versionado (LGPD art. 14) — quem, quando, IP, versão.
model ConsentRecord {
  id             String @id @default(cuid())
  registrationId String @unique

  guardianName String
  guardianCpf  String

  // Consentimentos específicos e separados (LGPD: consentimento específico).
  consentData       Boolean // tratamento de dados pessoais
  consentHealth     Boolean // dados sensíveis de saúde (art. 11)
  consentImage      Boolean // uso de imagem/foto/vídeo
  consentActivities Boolean // participação em atividades + atendimento médico de emergência

  termVersion String // ex.: "v1-2026-06"
  ip          String?
  userAgent   String?
  consentedAt DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String @id @default(cuid())
  registrationId String @unique

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  loteOrder   Int // lote vigente no momento do pagamento (auditoria)

  // Carnê (Pix parcelado). null/1 = à vista; 2 ou 3 = parcelado. Quando > 1,
  // a fonte de verdade dos pagamentos são as `installments` (uma por parcela);
  // os campos Pix abaixo (pixReceiptPath etc.) ficam sem uso no carnê.
  installmentsTotal Int?
  installments      Installment[]

  // Cupom de desconto. amountCents (e as parcelas) já guardam o valor COM
  // desconto; originalAmountCents preserva o preço cheio para auditoria.
  couponId            String?
  coupon              Coupon? @relation(fields: [couponId], references: [id])
  couponCode          String? // snapshot do código no momento da inscrição
  discountPercent     Int? // % aplicado
  originalAmountCents Int? // preço antes do desconto

  // Stripe (cartão)
  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  // Pix manual
  pixTxid        String? // referência = publicCode
  pixReceiptPath String? // caminho no bucket privado do Supabase Storage
  reviewedById   String?
  reviewedBy     User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([method, status])
}

// Parcela de um carnê Pix (até 3). Cada parcela tem seu próprio valor,
// vencimento, comprovante e revisão do admin. A vaga é garantida quando a
// primeira parcela (number = 1) é confirmada; as demais seguem como pendências.
model Installment {
  id        String @id @default(cuid())
  paymentId String

  number      Int // 1..3 (ordem/sequência da parcela)
  amountCents Int
  dueDate     DateTime
  status      PaymentStatus @default(PENDING)

  // Pix manual (por parcela)
  pixTxid        String? // referência = publicCode + number
  pixReceiptPath String? // caminho no bucket privado
  reviewedById   String?
  reviewedBy     User?     @relation("InstallmentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, number])
  @@index([status])
}

// Cupom de desconto percentual sobre o preço da inscrição. Código em maiúsculas.
// `uses` é incrementado a cada inscrição que usa o cupom (dentro da transação de
// criação), e `maxUses` trava novos usos quando atingido.
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int // 1..100
  active     Boolean   @default(true)
  expiresAt  DateTime? // validade opcional (null = sem validade)
  maxUses    Int? // limite de usos (null = ilimitado)
  uses       Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  payments Payment[]

  @@index([active])
}

// Categoria da despesa — o suficiente para agrupar num acampamento.
enum ExpenseCategory {
  LOCAL // aluguel/locação do espaço
  ALIMENTACAO
  TRANSPORTE
  MATERIAL // camisetas, papelaria, decoração
  EQUIPE // preleção, música, saúde
  ESTRUTURA // som, tenda, limpeza
  OUTRO
}

// Uma despesa do acampamento (ex.: aluguel do sítio). O VALOR TOTAL fica aqui;
// o que já saiu do caixa vive em `payments` — uma despesa pode ser paga em
// partes (a entrada do aluguel, depois o restante), e é isso que permite
// acompanhar o que ainda falta pagar.
model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory @default(OUTRO)
  /// Valor total combinado, em centavos.
  amountCents Int
  /// Fornecedor/quem recebe (opcional).
  supplier    String?
  /// Vencimento do saldo, quando houver.
  dueDate     DateTime?
  notes       String?

  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id])

  payments ExpensePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([dueDate])
}

// Uma saída de dinheiro referente a uma despesa. Vários por despesa: a entrada
// de R$2.000 do aluguel é um, o restante é outro.
model ExpensePayment {
  id          String          @id @default(cuid())
  expenseId   String
  amountCents Int
  paidAt      DateTime
  method      FormaPagamentoDespesa @default(PIX)
  notes       String?

  recordedById String?
  recordedBy   User?   @relation("ExpensePaymentRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([paidAt])
}

enum FormaPagamentoDespesa {
  PIX
  DINHEIRO
  CARTAO
  TRANSFERENCIA
  BOLETO
  OUTRO
}
